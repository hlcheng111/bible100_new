{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible100.local/schemas/locale_bundle.v1.schema.json",
  "title": "Bible100LocaleBundleV1",
  "description": "多語言字串包 Schema - 翻譯內容對照",
  "type": "object",
  "required": [
    "strings",
    "target_locale"
  ],
  "properties": {
    "strings": {
      "type": "object",
      "description": "鍵值對字串映射",
      "additionalProperties": {
        "type": "string"
      }
    },
    "target_locale": {
      "type": "string",
      "enum": [
        "zh-Hant",
        "zh-Hans",
        "en",
        "vi",
        "id",
        "ch",
        "ad",
        "kh",
        "lo",
        "my"
      ],
      "description": "目標語言"
    },
    "source_locale": {
      "type": "string",
      "description": "源語言"
    },
    "translation_meta": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "description": "翻譯引擎（ai | human）"
        },
        "source_locale": {
          "type": "string",
          "description": "源語言"
        },
        "target_locale": {
          "type": "string",
          "description": "目標語言"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "翻譯置信度"
        }
      }
    }
  }
}
