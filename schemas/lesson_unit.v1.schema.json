{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible100.local/schemas/lesson_unit.v1.schema.json",
  "title": "Bible100LessonUnitV1",
  "description": "教材單元 Schema - languages/ 課程結構化",
  "type": "object",
  "required": [
    "unit_type",
    "blocks"
  ],
  "properties": {
    "unit_type": {
      "type": "string",
      "enum": [
        "lesson",
        "landing",
        "sidebar_snippet",
        "qna_item"
      ],
      "description": "單元類型"
    },
    "track": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "OT",
            "NT",
            "T4",
            "100steps"
          ],
          "description": "軌道代碼"
        },
        "book": {
          "type": "string",
          "description": "書卷名稱"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "步驟編號"
        },
        "title_zh": {
          "type": "string",
          "description": "中文標題"
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "block_type"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "description": "區塊 ID"
          },
          "block_type": {
            "type": "string",
            "enum": [
              "text",
              "scripture",
              "checklist",
              "media",
              "prompt_template"
            ],
            "description": "區塊類型"
          },
          "title": {
            "$ref": "#/$defs/localeStringMap",
            "description": "區塊標題"
          },
          "body": {
            "$ref": "#/$defs/localeStringMap",
            "description": "區塊內容"
          },
          "scripture_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "book_id",
                "chapter"
              ],
              "properties": {
                "book_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 66,
                  "description": "書卷 ID（1-66）"
                },
                "chapter": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "章節"
                },
                "verse_start": {
                  "type": "integer",
                  "description": "起始節"
                },
                "verse_end": {
                  "type": "integer",
                  "description": "結束節"
                }
              }
            }
          }
        }
      }
    },
    "glossary_terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term_id": {
            "type": "string",
            "description": "術語 ID"
          },
          "zh-Hant": {
            "type": "string",
            "description": "繁體中文"
          },
          "en": {
            "type": "string",
            "description": "英文"
          },
          "theology_note": {
            "type": "string",
            "description": "神學註釋"
          }
        }
      }
    },
    "ai_policy": {
      "type": "object",
      "properties": {
        "allow_machine_translate": {
          "type": "boolean",
          "default": false,
          "description": "是否允許機器翻譯"
        },
        "require_human_review_before_publish": {
          "type": "boolean",
          "default": true,
          "description": "發布前是否需要人工審核"
        }
      }
    }
  },
  "$defs": {
    "localeStringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "zh-Hant",
          "zh-Hans",
          "en",
          "vi",
          "id",
          "ch",
          "ad",
          "kh",
          "lo",
          "my"
        ]
      }
    }
  }
}
