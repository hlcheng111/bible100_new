{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bible100.local/schemas/ai_draft.v1.schema.json",
  "title": "Bible100AiDraftV1",
  "description": "AI 草稿 Schema - Prompt 產出與人工審核紀錄",
  "type": "object",
  "required": [
    "draft_id",
    "workflow",
    "prompt_text",
    "disclaimer"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "format": "uuid",
      "description": "草稿 ID"
    },
    "workflow": {
      "type": "string",
      "enum": [
        "pastoral_followup",
        "lesson_prep",
        "qna_answer"
      ],
      "description": "工作流類型"
    },
    "prompt_text": {
      "type": "string",
      "description": "Prompt 文本"
    },
    "model_hint": {
      "type": "string",
      "description": "模型提示"
    },
    "output_text": {
      "type": "string",
      "description": "AI 輸出文本"
    },
    "disclaimer": {
      "type": "string",
      "description": "免責聲明"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "經文引用"
          },
          "verified": {
            "type": "boolean",
            "description": "是否已驗證"
          }
        }
      }
    },
    "human_review": {
      "type": "object",
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "是否需要人工審核"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "description": "審核狀態"
        },
        "reviewer_id": {
          "type": "string",
          "description": "審核者 ID"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "description": "審核時間"
        },
        "notes": {
          "type": "string",
          "description": "審核註釋"
        }
      }
    },
    "downstream_write": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean",
          "description": "是否允許寫入下游"
        },
        "target": {
          "type": "string",
          "enum": [
            "pastoral_events",
            "lesson_export",
            "none"
          ],
          "description": "寫入目標"
        },
        "written_at": {
          "type": "string",
          "format": "date-time",
          "description": "寫入時間"
        }
      }
    }
  }
}
