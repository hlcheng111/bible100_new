# Bible100 - InfinityFree / Apache
# Root / and /?i=1 -> index.html (QSA keeps query string)

DirectoryIndex index.html index.htm

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index_v5\.html$ index.html [R=301,L,QSA]
  RewriteRule ^$ index.html?v=20260813http [R=302,L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|index_v5\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
