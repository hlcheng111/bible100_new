{
  "name": "bible-app-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "generate:tracks": "python scripts/generate_reading_tracks.py",
    "build:shell-bundle": "python scripts/build_shell_data_bundle.py",
    "generate:kids": "python scripts/generate_kids_youth_content.py",
    "build:bible": "python scripts/json_to_sqlite.py",
    "test": "npm run test --workspace=@bible-app/core",
    "app:start": "npm run start --workspace=@bible-app/mobile",
    "app:web": "npm run web --workspace=@bible-app/mobile",
    "app:web:lan": "npm run web:lan --workspace=@bible-app/mobile",
    "app:web:preview": "npm run web:preview --workspace=@bible-app/mobile",
    "app:web:build": "npm run web:build --workspace=@bible-app/mobile"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
