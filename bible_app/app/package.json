{
  "name": "@bible-app/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "web:lan": "expo start --web --host lan --port 8082",
    "web:build": "expo export --platform web --output-dir dist",
    "web:serve": "npx --yes serve dist -l 3000",
    "web:preview": "npm run web:build && npm run web:serve",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@bible-app/core": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-clipboard": "~6.0.3",
    "expo-file-system": "~17.0.1",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.16",
    "@react-navigation/native": "^6.1.18",
    "expo-router": "~3.5.23",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "firebase": "^10.14.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.12"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "^5.4.5"
  }
}
