{
  "name": "bible-journey",
  "private": true,
  "version": "2.0.0-mvp",
  "type": "module",
  "description": "聖經跑道 2.0 — Vite SPA（網頁 / PWA / Electron 共用）",
  "scripts": {
    "predev": "node scripts/sync_tracks.js && node scripts/sync_coach.js",
    "dev": "vite",
    "prebuild": "node scripts/sync_tracks.js && node scripts/sync_coach.js",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/write_offline_readme.js",
    "build:offline": "node scripts/verify_bible_public.js && npm run build",
    "build:pwa": "node scripts/verify_bible_public.js && node scripts/build_pwa.js",
    "build:cloud": "node scripts/build_cloud.js",
    "verify:bible": "node scripts/verify_bible_public.js",
    "preview": "vite preview",
    "test:smoke": "node tests/smoke.test.mjs",
    "test:runner": "node tests/runner_profile.test.mjs",
    "test:coach": "node tests/coach_service.test.mjs",
    "export:bible": "node scripts/export_bible.js && node scripts/sync_bible_public.js",
    "sync:tracks": "node scripts/sync_tracks.js",
    "sync:coach": "node scripts/sync_coach.js",
    "electron:dev": "echo \"Electron: run npm run build first, then wire electron/main.cjs\"",
    "electron:build": "npm run build && echo \"Add electron-builder when ready\""
  },
  "devDependencies": {
    "better-sqlite3": "^11.8.1",
    "typescript": "^5.4.5",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-build": "^7.1.1"
  }
}
