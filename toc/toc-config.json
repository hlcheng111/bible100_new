  "scanSettings": {
    "excludePaths": [
      "archive/",
      "backup/",
      "temp/",
      "test/",
      "node_modules/",
      ".git/",
      "*.tmp/",
      "*.log/"
    ],
    "excludeFiles": [
      "*.tmp",
      "*.log",
      "*.bak",
      "*複製*",
      "*copy*",
      "*副本*",
      "*.swp",
      "*.cache"
    ],
    "includeExtensions": [
      ".html",
      ".htm"
    ],
    "maxFileSize": "10MB",
    "batchSize": 50,
    "timeout": 30000
  },
  
  "outputSettings": {
    "outputPath": "generated/",
    "createSubdirs": true,
    "generateMainTOC": true,
    "generateModuleTOCs": true,
    "generateLanguageTOCs": true,
    "includeTimestamps": true,
    "compressOutput": false
  },
  
  "uiSettings": {
    "theme": "modern",
    "colorScheme": "blue-purple",
    "responsive": true,
    "animations": true,
    "darkMode": "auto"
  },
  
  "performanceSettings": {
    "enableCaching": true,
    "cacheExpiry": 3600000,
    "lazyLoading": true,
    "compressAssets": true,
    "optimizeForMobile": true
  },
  
  "customization": {
